# Vorlage für den lokalen Swarm-Stack (Phase 1, LiteLLM) auf dem Mediaserver.
# Für Messläufe gehören alle Werte in benchmark.conf (Vorlage benchmark.conf.example);
# .env wird von der Testsuite nur noch gelesen, wenn benchmark.conf fehlt.
#
# Kopieren nach .env und dort ausfüllen.
# .env steht in .gitignore und wird nie committet.
# Nur Zugangsdaten verwenden, die ausschließlich für dieses Projekt angelegt wurden.

# RunPod (ab Phase 3) – API-Key aus den RunPod-Einstellungen
RUNPOD_API_KEY=

# RunPod: GPU-Typ aus `python3 runpod/rp.py gpus`, Cloud und Budget für alle Läufe
RUNPOD_GPU_ID=
RUNPOD_CLOUD=COMMUNITY
RUNPOD_BUDGET_USD=100

# Hugging Face (ab Phase 3) – Read-Token, nur für gated Modelle nötig
HF_TOKEN=

# vLLM (ab Phase 4) – schützt den Endpunkt im Pod. Pro Testlauf neu erzeugen,
# z. B. mit: openssl rand -hex 24. Im Pod als RunPod-Secret hinterlegen.
VLLM_API_KEY=

# LiteLLM (ab Phase 1) – Master-Key, mit dem die Benchmark-Skripte das
# lokale Gateway ansprechen. Im Swarm-Stack selbst liegt derselbe Key als
# Docker Secret (docker secret create), nicht in dieser Datei.
LITELLM_MASTER_KEY=

# Sicherheitsgrenze für GPU-Läufe (ab Phase 4): Pod wird spätestens
# nach dieser Zeit automatisch gelöscht
POD_MAX_MINUTES=90

# Testsuite: Ziel, wenn kein RunPod-Pod läuft (z. B. eigener Server). Mit /v1 am Ende.
BENCH_ZIEL_URL=
