# Vorlage – kopieren nach .env und dort ausfüllen.
# .env steht in .gitignore und wird nie committet.
# Nur PRIVATE Zugangsdaten verwenden, nichts aus dem beruflichen Umfeld.

# RunPod (ab Phase 3) – API-Key aus den RunPod-Einstellungen
RUNPOD_API_KEY=

# Hugging Face (ab Phase 3) – Read-Token, nur für gated Modelle nötig
HF_TOKEN=

# vLLM (ab Phase 4) – schützt den Endpunkt im Pod. Pro Testlauf neu erzeugen,
# z. B. mit: openssl rand -hex 24. Im Pod als RunPod-Secret hinterlegen.
VLLM_API_KEY=

# LiteLLM (ab Phase 1) – Master-Key, mit dem die Benchmark-Skripte das
# lokale Gateway ansprechen. Im Swarm-Stack selbst liegt derselbe Key als
# Docker Secret (docker secret create), nicht in dieser Datei.
LITELLM_MASTER_KEY=

# Sicherheitsgrenze für GPU-Läufe (ab Phase 4): Pod wird spätestens
# nach dieser Zeit automatisch gelöscht
POD_MAX_MINUTES=90
