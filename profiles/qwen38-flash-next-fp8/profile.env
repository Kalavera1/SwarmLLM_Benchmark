# Profil "qwen38-flash-next-fp8": Qwen3.8-Flash-Next (125B + 51B N-gram-Tabelle, 6B aktiv, Bilder).
# Die N-gram-Tabelle liegt im Arbeitsspeicher des Hosts (VLLM_PLE_CPU_OFFLOAD=1),
# sonst füllen schon die Gewichte die beiden Karten. Dafür ≥ 51 GB RAM plus Reserve.
# Quellen (Stand 16.11.2026):
#   https://recipes.vllm.ai/Qwen/Qwen3.8-Flash-Next
#   https://stondo.github.io/posts/qwen38-flash-next-512k-two-rtx-pro-6000/  (146,5 tok/s mit MTP3)
#
# Kontext: nativ 262k. stondo erreicht 524k mit YaRN-Faktor 2.0. Die genaue
# Override-Angabe übernehmen wir in Phase 5 aus seinem Rezept; bis dahin 262k,
# damit nichts ungetestet läuft. KV-Cache bleibt BF16: FP8 warf auf SM120 laut
# stondo einen Fehler im QSA-Pfad. max-num-seqs muss 256 bleiben (Mamba-Cache).

PROFIL_STATUS=bereit

# --- Modell und Image (Regel 4): pinnen mit  python3 profiles/pin.py qwen38-flash-next-fp8
MODEL_QUELLE=Qwen/Qwen3.8-Flash-Next-FP8
VLLM_IMAGE_QUELLE=vllm/vllm-openai:nightly
VLLM_IMAGE=

# --- Server
SERVED_NAME=qwen38-flash-next
MAX_MODEL_LEN=262144
SERVE_ARGS='--tensor-parallel-size 2 --max-num-seqs 256 --max-model-len 262144 --no-enable-flashinfer-autotune --reasoning-parser qwen3 --enable-auto-tool-choice --tool-call-parser qwen3_coder'
SPEC_CONFIG='{"method":"mtp","num_speculative_tokens":3}'
SERVE_ENV='VLLM_PLE_CPU_OFFLOAD=1'
# Prefix-Cache zusätzlich im RAM (Variante; leer = aus)
KV_CPU_OFFLOAD_GB=

# --- Fähigkeiten für die Testsuite
VISION=1
DENKSTUFEN='aus={"chat_template_kwargs":{"enable_thinking":false}};an={}'

# --- Host
GPU_ANZAHL=2
DISK_GB=260
HOST_RAM_MIN_GB=128
P2P_PFLICHT=1
HARDWARE='2x RTX PRO 6000 Blackwell (je 96 GB)'
