# Profil "mock": der Mock-Server aus chat-stack/mock/ – keine GPU, kein Geld.
# Zum Testen der Testsuite selbst: Jeder Block muss gegen den Mock laufen und
# ein gültiges JSON schreiben. Bestehen muss er nicht (der Mock rechnet nicht).
#
# Start des Mocks (ohne Key, nur lokal):
#   python3 chat-stack/mock/mock_openai.py --host 127.0.0.1 --port 8000

# Name, unter dem der Mock das Modell anbietet
SERVED_NAME=mock-model

# Großer Kontext, damit auch 500k- und 1M-Messungen durchlaufen
MAX_MODEL_LEN=1048576

# Bildblock mitlaufen lassen (der Mock ignoriert Bilder, antwortet aber)
VISION=1

# Nur der Mock darf ohne API-Key laufen (Regel 8 gilt für alle echten Ziele)
KEY_PFLICHT=0

# Denkstufen wie bei echten Modellen, damit der Block rechnen beide durchläuft
DENKSTUFEN='aus={"chat_template_kwargs":{"enable_thinking":false}};an={}'

HARDWARE='lokal, ohne GPU'

# Lastmix nur kurz laufen lassen (Selbsttest, nicht für echte Modelle)
LASTMIX_DAUER_S=20
