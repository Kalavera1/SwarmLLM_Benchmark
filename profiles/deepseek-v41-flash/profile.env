# Profil "deepseek-v41-flash": DeepSeek V4.1 Flash (763B, Bilder) – das wichtigste Modell.
# STATUS: ENTWURF. Der Weg ist noch nicht entschieden (siehe docs/entscheidungen.md):
#
#   Weg A – 2 Karten (Zielhardware): Rezept theogravity, EXL3 3 Bit (≈ 322 GiB),
#     Experten teils auf der CPU, Engram-Tabellen auf der NVMe. Braucht ≈ 250 GB RAM,
#     schnelle NVMe und einen starken Host (Kollege: EPYC 8004 mit DDR5). Die Images
#     (gepatchtes vLLM, Kernels, CPU-Runtime, LMCache) müssen erst gebaut werden.
#     https://github.com/theogravity/deepseek-flash-v4.1-dual-rtx-6000
#   Weg B – 4 Karten: Karmic-Kraken-Image mit Profil ds41-flash, Bilder verifiziert.
#     https://github.com/local-inference-lab/rtx6kpro/blob/master/models/deepseek-v4.1-flash.md
#
# Solange PROFIL_STATUS=entwurf ist, verweigern rp.py und lokal-starten.sh den Start.

PROFIL_STATUS=entwurf

MODEL_QUELLE=diffbot/DeepSeek-V4.1-Flash-EXL3-3bpw-2x-RTX-PRO-6000
SERVED_NAME=deepseek-v41-flash
MAX_MODEL_LEN=524288

# --- Fähigkeiten für die Testsuite
VISION=1

# --- Host: Kollege und Rezept nennen ≈ 250 GB RAM; CPU-Modell wird im Pod-Check geprüft
GPU_ANZAHL=2
DISK_GB=550
HOST_RAM_MIN_GB=250
HOST_CPU_MUSTER='EPYC (8|9)[0-9]{3}'
P2P_PFLICHT=1
HARDWARE='2x RTX PRO 6000 Blackwell (je 96 GB), CPU-Experten'
