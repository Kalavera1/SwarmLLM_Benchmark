# Profil "deepseek-v41-flash": DeepSeek V4.1 Flash (763B, Bilder) – Rang 2.
# STATUS: ENTWURF. Getestet wird nur mit 2 Karten; der Host ist noch offen:
#
#   2 Karten (Zielhardware): Rezept theogravity, EXL3 3 Bit (≈ 322 GiB),
#     Experten teils auf der CPU, Engram-Tabellen auf der NVMe. Braucht ≈ 250 GB RAM,
#     schnelle NVMe und einen starken Host (EPYC 9005 mit DDR5, wie der Zielserver). Die Images
#     (gepatchtes vLLM, Kernels, CPU-Runtime, LMCache) müssen erst gebaut werden.
#     https://github.com/theogravity/deepseek-flash-v4.1-dual-rtx-6000
#
# Solange PROFIL_STATUS=entwurf ist, verweigern rp.py und lokal-starten.sh den Start.

PROFIL_STATUS=entwurf

MODEL_QUELLE=diffbot/DeepSeek-V4.1-Flash-EXL3-3bpw-2x-RTX-PRO-6000
SERVED_NAME=deepseek-v41-flash
MAX_MODEL_LEN=524288

# --- Fähigkeiten für die Testsuite
VISION=1

# --- Host: ≈ 250 GB RAM (Rezept, Kollege). Zielserver: EPYC 9745 (Zen 5c, 12 Kanäle DDR5).
# Das Muster akzeptiert EPYC 9004/9005 (DDR5, 12 Kanäle); ältere EPYC 7xx3 mit DDR4
# sind für die CPU-Experten nicht repräsentativ. Der Host-Check misst die RAM-Bandbreite.
GPU_ANZAHL=2
DISK_GB=550
HOST_RAM_MIN_GB=250
HOST_CPU_MUSTER='EPYC 9[0-9]{3}'
P2P_PFLICHT=1
HARDWARE='2x RTX PRO 6000 Blackwell Max-Q (je 96 GB, 300 W), EPYC 9745, CPU-Experten'
