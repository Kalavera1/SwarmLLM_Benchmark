# Profil "glm53-flash-fp4": GLM-5.3-Flash (320B, 18B aktiv, Bilder und Video) als NVIDIA-FP4-Checkpoint.
# NVIDIA hat genau diese Hardware validiert: ≈ 166 GiB VRAM, 1,8 Mio. Token FP8-KV-Cache.
# Das neue NVFP4-Skalenformat ist (Stand 16.11.2026) nicht im Upstream-vLLM, deshalb
# der Container von Local Inference Lab.
# Quelle: https://huggingface.co/nvidia/GLM-5.3-Flash-FP4-Local
#
# Achtung: Ein Community-Test sah auf SM120 Endlosschleifen in der Ausgabe
# („locklock“). Der Block waechter muss bestehen, bevor Tempo-Werte zählen.

PROFIL_STATUS=bereit

# --- Modell und Image (Regel 4): pinnen mit  python3 profiles/pin.py glm53-flash-fp4
MODEL_QUELLE=nvidia/GLM-5.3-Flash-FP4-Local
VLLM_IMAGE_QUELLE=ghcr.io/local-inference-lab/vllm:release-10152026
VLLM_IMAGE=

# --- Server (Startparameter aus der NVIDIA-Modellkarte, vereinfacht)
SERVED_NAME=glm53-flash
MAX_MODEL_LEN=1048576
SERVE_ARGS='--tensor-parallel-size 2 --decode-context-parallel-size 2 --quantization modelopt_mixed --dtype bfloat16 --attention-backend B12X --moe-backend b12x --linear-backend b12x --kv-cache-dtype fp8 --block-size 256 --mamba-cache-mode align --enable-chunked-prefill --no-enable-flashinfer-autotune --max-model-len 1048576 --max-num-seqs 8 --max-num-batched-tokens 4096 --gpu-memory-utilization 0.985 --reasoning-parser glm45 --tool-call-parser glm47 --enable-auto-tool-choice'
SPEC_CONFIG='{"method":"mtp","num_speculative_tokens":5}'
SERVE_ENV=
KV_CPU_OFFLOAD_GB=

# --- Fähigkeiten für die Testsuite
VISION=1
DENKSTUFEN='aus={"chat_template_kwargs":{"enable_thinking":false}};an={}'

# --- Host
GPU_ANZAHL=2
DISK_GB=230
HOST_RAM_MIN_GB=128
P2P_PFLICHT=1
HARDWARE='2x RTX PRO 6000 Blackwell (je 96 GB)'
