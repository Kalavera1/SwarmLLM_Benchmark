# Profil "qwen38-27b": Qwen3.8-27B (dense, Bilder) – Referenzmodell und erster GPU-Test.
# Klein (≈ 29 GB Download), offizielles vLLM-Recipe für die RTX Pro 6000. Mit
# Data-Parallel 2 läuft auf jeder Karte eine eigene Kopie hinter einem Endpunkt.
# Quelle: https://recipes.vllm.ai/Qwen/Qwen3.8-27B (Stand 16.11.2026)
#
# Kontext nativ 262k: Die 500k-Pflichtpunkte werden übersprungen und als „nicht
# erreichbar“ vermerkt – erwartet, das Modell dient als Referenz.

PROFIL_STATUS=bereit

# --- Modell und Image (Regel 4): pinnen mit  python3 profiles/pin.py qwen38-27b
MODEL_QUELLE=nvidia/Qwen3.8-27B-NVFP4
VLLM_IMAGE_QUELLE=vllm/vllm-openai:v0.30.0
VLLM_IMAGE=

# --- Server
SERVED_NAME=qwen38-27b
MAX_MODEL_LEN=262144
SERVE_ARGS='--data-parallel-size 2 --max-model-len 262144 --kv-cache-dtype fp8 --reasoning-parser qwen3 --enable-auto-tool-choice --tool-call-parser qwen3_xml'
SPEC_CONFIG='{"method":"mtp","num_speculative_tokens":3}'
# SM120-Workaround: FlashInfer-Sampler-JIT stürzt sonst teils ab (Recipe-Hinweis)
SERVE_ENV='VLLM_USE_FLASHINFER_SAMPLER=0'

# --- Fähigkeiten für die Testsuite
VISION=1
DENKSTUFEN='aus={"chat_template_kwargs":{"enable_thinking":false}};an={}'

# --- Host
GPU_ANZAHL=2
DISK_GB=100
HOST_RAM_MIN_GB=64
P2P_PFLICHT=0
HARDWARE='2x RTX PRO 6000 Blackwell (je 96 GB)'
