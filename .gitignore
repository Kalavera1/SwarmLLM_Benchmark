results/mock/

# Daten des laufenden Pods (enthält den API-Key dieses Laufs)
runpod/.aktueller-pod.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Logs und lokale Daten
*.log
logs/
chat-stack/data/

# Editor und Betriebssystem
.vscode/
.idea/
.DS_Store
Thumbs.db

# Eigene Werte und Zugangsdaten (Vorlage: benchmark.conf.example)
benchmark.conf
