# Zugangsdaten – niemals committen
.env
.env.*
*.pem
*.key
id_rsa*
id_ed25519*

# Modellgewichte und große Binärdateien
*.safetensors
*.gguf
*.bin
*.pt
*.pth
*.ckpt
models/
weights/

# Caches (Hugging Face, vLLM, Triton, FlashInfer, JIT)
.cache/
