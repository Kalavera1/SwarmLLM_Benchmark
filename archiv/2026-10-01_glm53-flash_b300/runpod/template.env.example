# Umgebungsvariablen für den RunPod-Pod, so getestet am 01.10.2026.
# Eintragen in RunPod: Pod -> ⋮ -> Edit Pod -> "Environment variables" -> "+ Add Environment variable"
# (je Zeile ein Key/Value-Paar). Anleitung: INSTALLATION.md, Schritt 4.

# Inhalt von api-key.txt -- den echten Wert NIE in diese Datei oder ins Git schreiben
VLLM_API_KEY=<inhalt-von-api-key.txt>

# vLLM wartet bis zu 1 h auf Laden + Kompilieren
VLLM_ENGINE_READY_TIMEOUT_S=3600

# war gesetzt; vLLM meldet "deprecated", schadet nicht, kann auch weg
HF_HUB_ENABLE_HF_TRANSFER=1
